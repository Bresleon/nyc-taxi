{
  "annotations": { "list": [] },
  "editable": true,
  "title": "NYC Taxi Pipeline - Monitoreo de Recursos (8GB Limit)",
  "uid": "nyc-taxi-resources",
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Consumo de Memoria RAM - Contenedor Pipeline (MB)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "min": 0,
          "max": 8192,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 4096 },
              { "color": "red", "value": 7168 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_service=\"dagster\"} / 1024 / 1024",
          "legendFormat": "RAM Working Set (MB)"
        },
        {
          "expr": "container_memory_rss{container_label_com_docker_compose_service=\"dagster\"} / 1024 / 1024",
          "legendFormat": "RAM RSS (MB)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Uso de CPU - Contenedor Pipeline (%)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 } },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=\"dagster\"}[30s]) * 100",
          "legendFormat": "CPU Total (%)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memoria RAM por Servicio (Todos los Contenedores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "min": 0 } },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_service=~\".+\"} / 1024 / 1024",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ]
    }
  ]
}
